{
  "name": "github_light",
  "settings": [
    {
      "settings": {
        "background": "#FFFFFF",
        "foreground": "#1F2328",
        "caret": "#0969DA",
        "lineHighlight": "#F6F8FA",
        "selection": "#BBDFFF",
        "gutterForeground": "#8C959F",
        "highlightedDelimitersForeground": "#0969DA"
      }
    },
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#6E7781",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": "string, string.quoted, string.character.escape",
      "settings": {
        "foreground": "#0A3069"
      }
    },
    {
      "name": "Number & Constants",
      "scope": "constant.numeric, constant.language, constant.character, constant.other, variable.language",
      "settings": {
        "foreground": "#0550AE"
      }
    },
    {
      "name": "Keyword & Preprocessor",
      "scope": "keyword, keyword.control, keyword.operator, storage, storage.type, storage.modifier, keyword.control.directive, meta.preprocessor",
      "settings": {
        "foreground": "#CF222E"
      }
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function",
      "settings": {
        "foreground": "#8250DF"
      }
    },
    {
      "name": "Types & Parameters",
      "scope": "entity.name.type, support.type, support.type.primitive, variable.parameter",
      "settings": {
        "foreground": "#953800"
      }
    },
    {
      "name": "Braces & Punctuation",
      "scope": "punctuation, meta.brace",
      "settings": {
        "foreground": "#1F2328"
      }
    }
  ]
}